pipeline {
    agent any

    // 参数化
    parameters {
        string(name: 'REPOSITORY', defaultValue: 'contrastsecuritydemo/spring-petclinic', description: '镜像仓库地址')
        string(name: 'TAG', defaultValue: '1.5.1', description: '镜像 Tag')
        string(name: 'SERVICE_PORT', defaultValue: '8080', description: '服务及 HTTPRoute 后端端口')
        booleanParam(name: 'ENABLE_HTTPROUTE', defaultValue: true, description: '是否渲染并部署 HTTPRoute')
        string(name: 'GATEWAY_NAME', defaultValue: 'springboot-gateway', description: '绑定 Gateway 名称')
    }

    // 全局变量
    environment {
        RELEASE_NAME = 'mychart'
        CHART_NAME   = 'petclinic/generic-deployment'
        NAMESPACE    = 'default'
        VALUES_FILE  = 'zipkin/prod/values.yaml'
    }

    stages {
        stage('Helm Repo Update') {
            steps {
                sh '''
                    ${HELM_ACK_PROD_BIN} repo update
                '''
            }
        }

        stage('Deploy to ACK Prod') {
            steps {
                sh """
                    # 执行部署：通过 --set-json 将 hostnames 覆盖为空数组，通配所有域名与 ALB CNAME
                    \${HELM_ACK_PROD_BIN} upgrade --install ${RELEASE_NAME} ${CHART_NAME} \\
                      --namespace ${NAMESPACE} \\
                      -f ${VALUES_FILE} \\
                      --set-string image.repository=${params.REPOSITORY} \\
                      --set-string image.tag=${params.TAG} \\
                      --set service.port=${params.SERVICE_PORT} \\
                      --set httpRoute.enabled=${params.ENABLE_HTTPROUTE} \\
                      --set httpRoute.parentRefs[0].name=${params.GATEWAY_NAME} \\
                      --set-json 'httpRoute.hostnames=[]' \\
                      --set 'httpRoute.rules[0].matches[0].path.type=PathPrefix' \\
                      --set 'httpRoute.rules[0].matches[0].path.value=/' \\
                      --wait \\
                      --timeout 5m
                """
            }
        }
    }

    post {
        success { 
            echo "Helm Release ${RELEASE_NAME} (${params.REPOSITORY}:${params.TAG}) 部署并通过健康检查！" 
        }
        failure { 
            echo "Helm Release ${RELEASE_NAME} 部署失败（或 Pod 未就绪），请检查构建日志。" 
        }
    }
}