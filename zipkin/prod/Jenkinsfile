pipeline {
    agent any

    // 1. 同时接收 REPOSITORY 和 TAG 两个参数
    parameters {
        string(name: 'REPOSITORY', defaultValue: 'jasonops/petclinic', description: '镜像仓库地址')
        string(name: 'TAG', defaultValue: 'latest', description: '镜像 Tag')
    }

    environment {
        RELEASE_NAME = 'mychart'
        CHART_NAME   = 'petclinic/generic-deployment'
        NAMESPACE    = 'default'
        VALUES_FILE  = 'zipkin/prod/values.yaml'
    }

    stages {
        stage('Helm Repo Update') {
            steps {
                sh '''
                    ${HELM_PETCLINIC_PROD_BIN} repo update
                '''
            }
        }

        stage('Deploy to ACK Prod') {
            steps {
                // 2. 在 Helm 命令里增加 --set image.repository
                sh """
                    # 执行部署：同时动态覆盖镜像仓库和 Tag
                    \${HELM_PETCLINIC_PROD_BIN} upgrade --install ${RELEASE_NAME} ${CHART_NAME} \\
                      --namespace ${NAMESPACE} \\
                      -f ${VALUES_FILE} \\
                      --set image.repository=${params.REPOSITORY} \\
                      --set image.tag=${params.TAG}
                """
            }
        }
    }

    post {
        success { echo "Helm Release ${RELEASE_NAME} (${params.REPOSITORY}:${params.TAG}) 部署成功！" }
        failure { echo "Helm Release ${RELEASE_NAME} 部署失败，请检查构建日志。" }
    }
}